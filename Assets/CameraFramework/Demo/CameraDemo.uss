.hud {
    position: absolute;
    left: 32px;
    top: 32px;
    width: 380px;
    padding: 24px;
    background-color: rgba(11, 20, 30, 0.93);
    border-top-width: 2px;
    border-top-color: rgb(105, 233, 210);
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}
.header { margin-bottom: 20px; }
.eyebrow { color: rgb(105, 233, 210); font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; }
.title { color: rgb(246, 247, 243); font-size: 28px; -unity-font-style: bold; margin-top: 8px; }
.subtitle { color: rgb(152, 171, 182); font-size: 11px; margin-top: 6px; }
.section { margin-top: 13px; padding-top: 13px; border-top-width: 1px; border-top-color: rgb(45, 65, 73); }
.section-title { color: rgb(105, 233, 210); font-size: 10px; -unity-font-style: bold; margin-bottom: 9px; letter-spacing: 1px; }
.row { flex-direction: row; margin-bottom: 6px; }
.button { flex-grow: 1; height: 33px; margin-right: 6px; color: rgb(225, 235, 234); background-color: rgb(35, 52, 63); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; font-size: 10px; -unity-font-style: bold; }
.button:hover { background-color: rgb(55, 84, 92); }
.accent { background-color: rgb(22, 118, 111); }
.footer { color: rgb(89, 112, 122); font-size: 9px; margin-top: 19px; letter-spacing: 1px; }
.corner { position: absolute; right: 30px; bottom: 26px; color: rgb(215, 227, 225); font-size: 10px; letter-spacing: 2px; }
